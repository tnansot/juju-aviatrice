{
  "name": "@juju-aviatrice/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./trpc": {
      "types": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "dev": "tsx src/migrate.ts && NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc --build && node scripts/copy-content.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "reset:onboarding": "tsx scripts/reset-onboarding.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.18.0",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.26",
    "pino": "^9.6.0",
    "superjson": "^2.2.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.0",
    "trpc-panel": "^1.3.4",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^3.1.3"
  }
}
